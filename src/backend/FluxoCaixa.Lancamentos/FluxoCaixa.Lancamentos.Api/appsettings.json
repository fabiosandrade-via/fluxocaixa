{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LancamentosDb": "Host=${DB_LANCAMENTOS_HOST};Port=${DB_LANCAMENTOS_PORT};Database=${DB_LANCAMENTOS_NAME};Username=${DB_LANCAMENTOS_USER};Password=${DB_LANCAMENTOS_PASSWORD}"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "Auth": {
    "Authority": "http://localhost:8081/realms/fluxocaixa",
    "Audience": "fluxocaixa-api"
  }
}
