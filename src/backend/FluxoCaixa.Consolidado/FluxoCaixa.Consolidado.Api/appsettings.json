{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "${MONGO_CONSOLIDADO_CONNECTION_STRING}",
    "DatabaseName": "${MONGO_CONSOLIDADO_DB}",
    "ColecaoSaldos": "saldos_consolidados"
  },
  "ConnectionStrings": {
    "Redis": "${REDIS_CONNECTION_STRING}"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "Auth": {
    "Authority": "http://localhost:8081/realms/fluxocaixa",
    "Audience": "fluxocaixa-api"
  }
}
